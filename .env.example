# =============================================================================
# StayScore — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# Em desenvolvimento use o Postgres do docker-compose.yml (`npm run db:up`).
DATABASE_URL="postgresql://stayscore:stayscore@localhost:5432/stayscore?schema=public"

# --- Autenticação (Auth.js) ---------------------------------------------------
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# URL pública da aplicação (obrigatório em produção)
AUTH_URL="http://localhost:3000"

# --- Providers de dados de anúncio -------------------------------------------
# MOCK   = fixture embutida, claramente marcada como simulada
# MANUAL = dados informados pelo usuário no formulário
# (RealAirbnbProvider/RealBookingProvider ainda não existem — exigem fonte
#  oficial ou parceria. Ver src/server/core/providers/listing/README.md)
AIRBNB_PROVIDER="MOCK"
BOOKING_PROVIDER="MOCK"

# --- Provider de pricing ------------------------------------------------------
# CSV_PRICELABS = upload de CSV exportado do PriceLabs (única opção do MVP)
# PRICELABS_API = requer credenciais/parceria; ainda não disponível
PRICING_PROVIDER="CSV_PRICELABS"

# --- Providers de IA (Etapa 3+) ----------------------------------------------
# MOCK permite rodar todo o fluxo sem gastar créditos nem ter chave configurada.
VISION_PROVIDER="MOCK"          # MOCK | GEMINI | ANTHROPIC | OPENAI
LLM_PROVIDER="MOCK"             # MOCK | GEMINI | ANTHROPIC | OPENAI | OPENAI_COMPATIBLE

GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Gateway de IA (OmniRoute, OpenRouter, Groq, modelo local) ----------------
# OPENAI_COMPATIBLE serve qualquer endpoint que fale /v1/chat/completions.
# É o caminho para rotear cada chamada ao fornecedor mais barato disponível —
# inclusive os de camada gratuita — sem mudar uma linha de código.
#
# Com o OmniRoute rodando na máquina (npm install -g omniroute && omniroute):
#   LLM_PROVIDER="OPENAI_COMPATIBLE"
#   LLM_BASE_URL="http://localhost:20128/v1"
#   LLM_API_KEY="<chave gerada no painel do OmniRoute>"
#   LLM_MODEL_CHEAP="<modelo gratuito>"     # classificação, volume alto
#   LLM_MODEL_SMART="<modelo melhor>"       # estratégia e resposta de venda
#
# ATENÇÃO à privacidade: vários fornecedores gratuitos treinam com o que você
# manda. Conversa de cliente é dado pessoal (LGPD) — para os modelos que veem
# mensagens de gente real, prefira fornecedor com garantia de não-treinamento.
LLM_BASE_URL=""
LLM_API_KEY=""
# Alguns modelos roteados não aceitam response_format. O sistema já repete a
# chamada sem o campo quando isso acontece; desligue aqui para evitar a ida
# perdida se o seu gateway nunca aceitar.
LLM_JSON_MODE="true"

# Modelos: barato para tarefas simples, avançado só quando necessário.
#
# ATENÇÃO: o Google retira modelos antigos do acesso de contas novas. O
# `gemini-2.5-flash` já devolve 404 ("no longer available to new users") para
# elas. Liste os que a SUA chave acessa antes de fixar um valor:
#
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models" \
#     -H "x-goog-api-key: $GEMINI_API_KEY" | grep '"name"'
#
# Os aliases (gemini-flash-lite-latest) não expiram, mas o modelo por trás
# muda sem aviso — o que faz notas de análises antigas deixarem de ser
# comparáveis com as novas. Preferimos fixar a versão.
VISION_MODEL="gemini-3.5-flash-lite"
LLM_MODEL_CHEAP="gemini-3.5-flash-lite"
LLM_MODEL_SMART="gemini-3.5-flash"

# Análise de fotos: uma chamada por imagem, com paralelismo limitado.
VISION_CONCURRENCY="3"
VISION_TIMEOUT_MS="45000"
VISION_RETRIES="2"
VISION_CACHE_TTL_DAYS="30"

# Tabela de preços por modelo, para estimar custo.
# DEIXAR VAZIO É SEGURO: os tokens continuam sendo registrados de verdade no
# AIUsageLog e o custo aparece como "desconhecido" — o sistema nunca inventa um
# valor. Preencha com os números da tabela oficial do fornecedor (USD por
# 1 milhão de tokens) para ativar a estimativa de custo:
# MODEL_PRICING_JSON='{"gemini-2.5-flash":{"inputPerMillion":0,"outputPerMillion":0}}'
MODEL_PRICING_JSON=""

# --- Storage de fotos ---------------------------------------------------------
# LOCAL = disco local (dev). S3 exige credenciais e ainda não está implementado.
STORAGE_PROVIDER="LOCAL"
STORAGE_LOCAL_DIR="./storage"

# --- Limites e custo ----------------------------------------------------------
MAX_PHOTOS_PER_ANALYSIS="30"
MAX_PHOTO_SIZE_MB="10"
MAX_CSV_SIZE_MB="10"
# Teto de custo estimado por análise, em USD. Acima disso a análise é barrada.
MAX_COST_PER_ANALYSIS_USD="1.00"

# =============================================================================
# GROWTH ENGINE — marketing e vendas por agentes
#
# Com os valores abaixo, o módulo roda inteiro sem credencial e sem custo:
# modelo, redes sociais e geração de mídia simulados. Nada sai para a internet,
# e todo resultado vem marcado como exemplo.
# =============================================================================

# --- Redes sociais ------------------------------------------------------------
# MOCK = nada é publicado nem enviado de verdade (padrão)
# META = APIs oficiais do Instagram/Facebook; exige App Review aprovado,
#        conta Business vinculada a uma Página e token de longa duração.
SOCIAL_PROVIDER="MOCK"

# Versão da Graph API. A Meta aposenta versões em ~2 anos; subir é decisão
# consciente, não efeito colateral de deploy.
META_GRAPH_VERSION="v21.0"

# Segredo do app — valida a assinatura (X-Hub-Signature-256) do webhook.
# Sem ele, o endpoint de webhook recusa TODA requisição, inclusive em dev.
META_APP_SECRET=""

# Token ecoado na verificação do webhook (hub.verify_token).
META_VERIFY_TOKEN=""

# Token padrão de acesso. O token por conta vem de `SocialAccount.tokenRef`,
# que guarda o NOME de uma variável de ambiente — nunca o token em si.
# Ex.: cadastre a conta com tokenRef="META_TOKEN_LOJA" e defina abaixo:
# META_TOKEN_LOJA="EAAG..."
META_ACCESS_TOKEN=""

# --- Geração de mídia ---------------------------------------------------------
# MOCK gera arquivos reais e rotulados (SVG de exemplo, storyboard, roteiro de
# narração) para o fluxo de aprovação ser testável de ponta a ponta.
# OPENAI_COMPATIBLE usa /v1/images/generations do mesmo LLM_BASE_URL — é como
# o OmniRoute expõe geradores de imagem, inclusive os gratuitos.
IMAGE_PROVIDER="MOCK"           # MOCK | GEMINI | OPENAI_COMPATIBLE
VIDEO_PROVIDER="MOCK"           # MOCK | EXTERNAL (exige implementar VideoProvider)
TTS_PROVIDER="MOCK"             # MOCK | EXTERNAL (exige implementar SpeechProvider)
IMAGE_MODEL="gemini-3.5-flash-image"

# --- Fila e worker ------------------------------------------------------------
GROWTH_WORKER_BATCH_SIZE="5"
GROWTH_JOB_LOCK_TIMEOUT_MS="300000"

# Janela de resposta da plataforma, em horas. Fora dela nenhuma mensagem sai —
# nem no modo autônomo. Configurável porque a Meta já mudou esse número.
GROWTH_MESSAGE_WINDOW_HOURS="24"

# Teto de custo de IA por workspace por dia, em USD.
GROWTH_MAX_DAILY_COST_USD="2"

# Protege POST /api/growth/worker/tick, chamado pelo cron externo.
CRON_SECRET=""
